{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stac-extensions.github.io/scientific/v1.1.0/schema.json#",
  "title": "Scientific Citation Extension",
  "description": "Scientific Citation Extension for STAC Catalogs, STAC Collections, and STAC Items.",
  "type": "object",
  "required": [
    "stac_extensions",
    "type"
  ],
  "properties": {
    "stac_extensions": {
      "type": "array",
      "contains": {
        "const": "https://stac-extensions.github.io/scientific/v1.1.0/schema.json"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "Catalog",
        "Collection",
        "Feature"
      ]
    },
    "assets": {
      "$comment": "This validates the fields in Item and Collection Assets, but does not require them.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/fields"
      }
    },
    "links": {
      "$comment": "This validates the fields in Links, but does not require them.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/fields"
      }
    },
    "providers": {
      "$comment": "This validates the fields in Providers of Collections, but does not require them.",
      "$ref": "#/definitions/providers"
    }
  },
  "oneOf": [
    {
      "$comment": "This validates the fields in Item Properties, including Providers.",
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "properties": {
          "allOf": [
            {
              "$ref": "#/definitions/fields"
            },
            {
              "properties": {
                "providers": {
                  "$ref": "#/definitions/providers"
                }
              }
            }
          ]
        }
      }
    },
    {
      "$comment": "This validates the top-level fields, Summaries and Item Asset Definitions in Collections.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Collection"
        },
        "summaries": {
          "$ref": "#/definitions/summaries"
        },
        "item_assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/fields"
          }
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/fields"
        }
      ]
    },
    {
      "$comment": "This validates the top-level fields in Catalogs.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "Catalog"
        }
      },
      "allOf": [
        {
          "$ref": "#/definitions/fields"
        }
      ]
    }
  ],
  "definitions": {
    "sci:doi": {
      "type": "string",
      "title": "Data DOI",
      "pattern": "^10\\.[0-9a-zA-Z]{4,}/[^\\s]+$"
    },
    "sci:citation": {
      "type": "string",
      "title": "Proposed Data Citation"
    },
    "sci:publications": {
      "type": "array",
      "title": "Publications",
      "items": {
        "$ref": "#/definitions/publication"
      }
    },
    "publication": {
      "type": "object",
      "properties": {
        "doi": {
          "type": "string",
          "title": "Publication DOI",
          "pattern": "^10\\.[0-9a-zA-Z]{4,}/[^\\s]+$"
        },
        "citation": {
          "type": "string",
          "title": "Publication Citation"
        }
      }
    },
    "fields": {
      "$comment": "Don't require fields here as they would be required in all places where we reference the fields as possibly allowed.",
      "type": "object",
      "properties": {
        "sci:doi": {
          "$ref": "#/definitions/sci:doi"
        },
        "sci:citation": {
          "$ref": "#/definitions/sci:citation"
        },
        "sci:publications": {
          "$ref": "#/definitions/sci:publications"
        }
      },
      "patternProperties": {
        "^(?!sci:)": {}
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/fields"
      }
    },
    "summaries": {
      "$comment": "Validates summaries provided as lists. JSON Schema (type: object) can always be provided for fields.",
      "type": "object",
      "properties": {
        "sci:doi": {
          "type": [
            "array",
            "object"
          ],
          "items": {
            "$ref": "#/definitions/sci:doi"
          }
        },
        "sci:citation": {
          "type": [
            "array",
            "object"
          ],
          "items": {
            "$ref": "#/definitions/sci:citation"
          }
        },
        "sci:publications": {
          "type": [
            "array",
            "object"
          ],
          "items": {
            "$ref": "#/definitions/publication"
          }
        }
      },
      "patternProperties": {
        "^(?!sci:)": {}
      },
      "additionalProperties": false
    }
  }
}
